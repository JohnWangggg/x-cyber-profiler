# Copy to .env.local and fill these in. Never commit .env.local.
JEV_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
JEV_SCHEMA=xcp.profile.v1
JEV_KEY=
# TYPESAFE_API_KEY=...  # accepted as a fallback
# bearer | x-api-key | header
JEV_AUTH=bearer

# Optional namer (OpenAI-compatible)
NAMER_PROVIDER=openai
NAMER_URL=https://api.deepseek.com/v1/chat/completions
NAMER_MODEL=deepseek-chat
NAMER_KEY=
LABEL_LANG=en
LABEL_TONE=sharp
# Local Magpie alternative (no key):
# NAMER_PROVIDER=openai
# NAMER_URL=http://127.0.0.1:3425/v1/chat/completions
# NAMER_MODEL=auto/glm-5.3-flash
# NAMER_KEY=
